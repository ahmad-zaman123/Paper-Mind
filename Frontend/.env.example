# Backend the Vite dev server proxies /api to. Not used in production builds:
# vercel.json rewrites /api/* to the deployed backend instead.
VITE_API_URL=http://127.0.0.1:8009

# Optional: shows "Continue with Google" on the sign-in page. Same client id as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
